{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "npm run contract:emit",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run typecheck",
    "typecheck": "prisma contract emit && tsc --noEmit",
    "contract:emit": "prisma contract emit",

    "db:migrate": "prisma db migrate",
    "db:seed": "tsx scripts/seed-platform.ts",
    "db:migrate:legacy": "tsx scripts/migrate-json-to-pg.ts",
    "db:migrate:legacy:dry": "MIGRATE_DRY_RUN=1 tsx scripts/migrate-json-to-pg.ts",
    "db:status": "prisma migration status",
    "db:verify": "prisma db verify",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:dev": "docker compose up -d postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",

    "test": "tsx test/run-all.ts",
    "test:unit": "tsx test/run-all.ts --only=unit",
    "test:db": "tsx test/run-all.ts --only=db",
    "test:http": "tsx test/run-all.ts --only=http",
    "test:isolation": "tsx test/step12-isolation.ts",
    "test:context": "tsx test/step12-tenant-context.ts",
    "test:verticals": "tsx test/step12-verticals.ts",
    "test:rbac": "tsx test/step11bfix-authorization.ts",
    "test:rbac:http": "tsx test/step11bfix-generic-routes-http.ts",
    "test:provisioning": "tsx test/step12-provisioning.ts",
    "test:platform:http": "tsx test/step12-platform-http.ts",
    "test:fix": "tsx test/step12fix-concurrency-domain.ts",
    "test:legacy": "tsx test/step12fix-legacy-migration.ts",
    "test:fresh": "tsx test/step12fix-fresh-db.ts",
    "test:gate": "tsx test/step12fix-legacy-json-guard.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jalaali-js": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^8.0.0-rc.15",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.3"
  }
}
