# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Tenant resolution (Step 12) ---
# DEV_TENANT_SLUG selects a tenant by slug for local development (NODE_ENV !== production only).
# The migration script does NOT create TenantDomain rows, so without this variable
# the global middleware attaches no tenant context (routes that need one enforce it themselves).
DEV_TENANT_SLUG=""

# TENANT_PARENT_DOMAINS is a comma-separated list of parent domains used to extract
# the tenant slug from subdomain hostnames (e.g. "acme.mmba.example" → slug "acme").
# Default works for localhost development; override in production.
TENANT_PARENT_DOMAINS="mmba.example,localhost"
