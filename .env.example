# GEMINI_API_KEY: Optional — Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted (used for self-referential links).
# Required in production when behind a reverse proxy.
APP_URL=""

# JWT_SECRET: REQUIRED — Secret key for signing session tokens.
# Server will refuse to start if this is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Runtime environment: development | production
# Controls CSP, Vite dev server, and error detail exposure.
NODE_ENV="development"

# Centralized Database Configuration
DATABASE_PATH="./data/mmba_production_database.json"
# Backup storage root (default: ./data/backups)
BACKUP_STORAGE_PATH="./data/backups"

# VAPID keys — Web Push. If unset, the server generates a keypair and persists
# it to ./data/vapid_keys.json. Set both to pin a stable pair across restarts.
# IMPORTANT: Both or neither — partial configuration is refused at startup.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact subject included in Web Push payloads (default: mailto:admin@mmba.ir)
VAPID_SUBJECT="mailto:admin@mmba.ir"

# CORS: comma-separated allowed origins for authenticated API requests.
# Required in production; development defaults to localhost.
# Example: ALLOWED_ORIGINS="https://panel.example.com,https://admin.example.com"
ALLOWED_ORIGINS=""

# Set to "true" when running behind a reverse proxy (nginx, Caddy, Traefik).
# Enables trust proxy so req.ip sees the real client address, not the proxy.
TRUST_PROXY=""

# Server port (default: 3000)
PORT="3000"
