# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: REQUIRED — Secret key for signing session tokens.
# Server will refuse to start if this is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Centralized Database Configuration
DATABASE_PATH="./data/mmba_production_database.json"
DATABASE_URL=""
# Backup storage root (default: ./data/backups)
BACKUP_STORAGE_PATH="./data/backups"

# VAPID keys — Web Push. If unset, the server generates a keypair and persists
# it to ./data/vapid_keys.json. Set both to pin a stable pair across restarts.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact subject included in Web Push payloads (default: mailto:admin@mmba.ir)
VAPID_SUBJECT="mailto:admin@mmba.ir"
